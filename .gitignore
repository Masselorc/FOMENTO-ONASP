.codex-temp/
node_modules/
.env
.env.*
!.env.example
.env.local
.env.*.local
playwright-report/
test-results/
blob-report/

# Memória versionada parcialmente
# Versionar notas Markdown e dados tratados não sensíveis.
# Não versionar arquivos locais do Obsidian, fontes brutas ou anexos pesados/sensíveis.
memoria/.obsidian/
memoria/.trash/
memoria/99_FONTES_BRUTAS/
memoria/**/*.pdf
memoria/**/*.xlsx
memoria/**/*.xls
memoria/**/*.docx
memoria/**/*.doc
memoria/**/*.pptx
memoria/**/*.ppt
memoria/**/*.zip
memoria/**/*.rar
memoria/**/*.7z
memoria/**/*.png
memoria/**/*.jpg
memoria/**/*.jpeg
memoria/**/*.webp

# Dados externos baixados automaticamente (não versionar ZIP/CSV do DETRU)
Dados/detru/*.zip
Dados/detru/*.csv
Dados/detru/*.tmp

# Ambientes e dados locais
backend/logs/
*.log
_codex_backup_*/
_codex_backup*/
*_backup_*/

# Banco de dados — versionado durante desenvolvimento (ver FOMENTO-ONASP#db-versioning)
# Remover as exceções abaixo quando o banco estabilizar em produção
!backend/data/onasp.sqlite
!backend/data/onasp-mj-12666669.sqlite
!backend/data/backups/
backend/data/onasp.sqlite-shm
backend/data/onasp.sqlite-wal
# Outros .sqlite fora de backend/data permanecem ignorados
*.sqlite-shm
*.sqlite-wal

# Backups locais de banco de dados
backend/backups/
