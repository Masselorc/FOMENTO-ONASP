ONASP_EDIT_PASSWORD=troque_esta_senha
HOST=127.0.0.1
PORT=8790

# Ambiente de execução da aplicação. Qualquer valor de produção em
# FOMENTO_AMBIENTE, NODE_ENV, APP_ENV ou AMBIENTE ativa os bloqueios
# conservadores. Valores de produção reconhecidos: producao, produção, production, prod.
FOMENTO_AMBIENTE=desenvolvimento

# PROFOR 2022 — origem de dados.
# A origem operacional atual e unica e PAD/reconstrucao. Valores legados
# "planilha" e "banco-cache" sao normalizados para reconstrucao-pad.
PROFOR_2022_ORIGEM_DADOS=reconstrucao-pad

# PROFOR 2022 — endpoints administrativos e chamadas externas.
# Ações administrativas disparadas pela interface local utilizam ONASP_EDIT_PASSWORD.
# Chamadas administrativas externas/não locais exigem PROFOR_ADMIN_TOKEN configurado.
# Nunca exponha nem envie PROFOR_ADMIN_TOKEN para o frontend.
PROFOR_ADMIN_TOKEN=
# Endpoints administrativos chamados remotamente/sem loopback exigem ALLOW_PROFOR_2022_ADMIN_ENDPOINTS=1.
# Chamadas DETRU/Transferegov remotas/sem loopback exigem ALLOW_PROFOR_2022_EXTERNAL_CALLS=1.
# Em producao e em testes, essas flags nao liberam chamadas externas.
ALLOW_PROFOR_2022_ADMIN_ENDPOINTS=
ALLOW_PROFOR_2022_EXTERNAL_CALLS=

# DETRU — atualização automática do siconv_convenio.csv.zip
# DETRU_SICONV_CONVENIO_URL deve ser a URL pública do arquivo (http:// ou https://).
# Deixar vazio para usar apenas o arquivo local.
DETRU_SICONV_CONVENIO_URL=
DETRU_SICONV_CONVENIO_LOCAL=Dados/detru/siconv_convenio.csv.zip
DETRU_ATUALIZACAO_DIARIA_HORA=06:00

# PROFOR 2022 — horario diario da rotina sensivel.
# O comando ordinario `npm run agendar:profor-2022` esta bloqueado. Agendadores
# exigem ALLOW_PROFOR_2022_SCHEDULER=1 em desenvolvimento; em producao, a flag
# nao libera. Formato HH:MM em fuso local.
ALLOW_PROFOR_2022_SCHEDULER=
PROFOR_2022_ATUALIZACAO_DIARIA_HORA=06:30
