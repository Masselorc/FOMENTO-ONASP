ONASP_EDIT_PASSWORD=troque_esta_senha
HOST=127.0.0.1
PORT=8790

# Ambiente de execução da aplicação. Qualquer valor de produção em
# FOMENTO_AMBIENTE, NODE_ENV, APP_ENV ou AMBIENTE ativa os bloqueios
# conservadores. Valores de produção reconhecidos: producao, produção, production, prod.
FOMENTO_AMBIENTE=desenvolvimento

# PROFOR 2022 — origem de dados.
# Padrao atual do codigo: banco-cache. "reconstrucao-pad" so com selecao explicita controlada.
PROFOR_2022_ORIGEM_DADOS=banco-cache

# PROFOR 2022 — gate para uso de workbook (planilha antiga) no fluxo local.
# Quando PROFOR_2022_ORIGEM_DADOS=reconstrucao-pad, montarConsolidadoProfor2022Local
# bloqueia a leitura silenciosa da planilha antiga. Para uso temporario em
# desenvolvimento (ex.: inspecao do consolidado legado), defina 1; em producao,
# deixe vazio ou ausente para preservar a salvaguarda. PROIBIDO em producao
# mesmo com 1: o guard reconhece NODE_ENV=production, APP_ENV=production e
# AMBIENTE/FOMENTO_AMBIENTE=producao e SEMPRE falha. NUNCA usar 1 sem aviso.
ALLOW_PROFOR_2022_WORKBOOK_FALLBACK=

# PROFOR 2022 — endpoints dev/auditoria.
# Libera endpoints como /api/profor-2022/comparar-origens apenas em
# desenvolvimento. Em producao, FOMENTO_AMBIENTE/NODE_ENV/APP_ENV/AMBIENTE
# bloqueiam sempre, mesmo com 1.
ALLOW_PROFOR_2022_ENDPOINTS_DEV=

# PROFOR 2022 — gate para execucao do orquestrador legado atualizar:profor-2022.
# O orquestrador aciona Transferegov e le workbook via carregarPlanoAplicacaoLocal.
# Esta sendo descontinuado em favor do fluxo PAD/reconstrucao. Para execucao
# pontual em desenvolvimento, defina 1; em producao, PROIBIDO mesmo com 1
# (mesma regra de FOMENTO_AMBIENTE/NODE_ENV/APP_ENV/AMBIENTE acima).
ALLOW_PROFOR_2022_ORQUESTRADOR_LEGADO=

# DETRU — atualização automática do siconv_convenio.csv.zip
# DETRU_SICONV_CONVENIO_URL deve ser a URL pública do arquivo (http:// ou https://).
# Deixar vazio para usar apenas o arquivo local.
DETRU_SICONV_CONVENIO_URL=
DETRU_SICONV_CONVENIO_LOCAL=Dados/detru/siconv_convenio.csv.zip
DETRU_ATUALIZACAO_DIARIA_HORA=06:00

# PROFOR 2022 — horario diario da rotina consolidada (DETRU + rendimentos + consolidado).
# Usado por `npm run agendar:profor-2022`. Formato HH:MM em fuso local.
PROFOR_2022_ATUALIZACAO_DIARIA_HORA=06:30
