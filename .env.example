ONASP_EDIT_PASSWORD=troque_esta_senha
HOST=127.0.0.1
PORT=8790

# PROFOR 2022 — origem de dados.
# Padrao atual do codigo: banco-cache. "reconstrucao-pad" so com selecao explicita controlada.
PROFOR_2022_ORIGEM_DADOS=banco-cache

# PROFOR 2022 — gate para uso de workbook (planilha antiga) no fluxo local.
# Quando PROFOR_2022_ORIGEM_DADOS=reconstrucao-pad, montarConsolidadoProfor2022Local
# bloqueia a leitura silenciosa da planilha antiga. Para uso temporario em
# desenvolvimento (ex.: inspecao do consolidado legado), defina 1; em producao,
# deixe vazio ou ausente para preservar a salvaguarda. NUNCA usar 1 sem aviso.
ALLOW_PROFOR_2022_WORKBOOK_FALLBACK=

# DETRU — atualização automática do siconv_convenio.csv.zip
# DETRU_SICONV_CONVENIO_URL deve ser a URL pública do arquivo (http:// ou https://).
# Deixar vazio para usar apenas o arquivo local.
DETRU_SICONV_CONVENIO_URL=
DETRU_SICONV_CONVENIO_LOCAL=Dados/detru/siconv_convenio.csv.zip
DETRU_ATUALIZACAO_DIARIA_HORA=06:00

# PROFOR 2022 — horario diario da rotina consolidada (DETRU + rendimentos + consolidado).
# Usado por `npm run agendar:profor-2022`. Formato HH:MM em fuso local.
PROFOR_2022_ATUALIZACAO_DIARIA_HORA=06:30
